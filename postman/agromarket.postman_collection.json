{
  "info": {
    "name": "AgroMarket API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Лабораторная 6. Запускать в указанном порядке. Каждый запуск создаёт и удаляет собственный товар; созданная заявка остаётся, так как DELETE orders не предусмотрен ТЗ. npm run test:postman использует отдельную временную схему и удаляет все тестовые данные после двух запусков."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('База подключена', () => pm.expect(pm.response.json().db).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Поиск товаров",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products?search=мол"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Ответ — массив', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Создать товар",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест\",\n  \"price\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201', () => pm.response.to.have.status(201));",
              "pm.test('Числовой id и имя', () => { const b=pm.response.json(); pm.expect(b.id).to.be.a('number'); pm.expect(b.name).to.eql('Тест'); });",
              "pm.collectionVariables.set('productId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Получить товар",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Верный id', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('productId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Изменить товар",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест 2\",\n  \"price\": 150\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Товар обновлён', () => { pm.expect(pm.response.json().price).to.eql(150); pm.expect(pm.response.json().name).to.eql('Тест 2'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Товар плохие данные",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": -5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Создать заявку",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест\",\n  \"email\": \"t@t.kz\",\n  \"quantity\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('orderId', pm.response.json().id);",
              "pm.test('Заявка new', () => pm.expect(pm.response.json().status).to.eql('new'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Заявка меньше 10 кг",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест\",\n  \"email\": \"t@t.kz\",\n  \"quantity\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400', () => pm.response.to.have.status(400));",
              "pm.test('Сообщение про 10 кг', () => pm.expect(pm.response.json().error).to.include('10 кг'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Статус заявки",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/orders/{{orderId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"processing\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Статус изменён', () => pm.expect(pm.response.json().status).to.eql('processing'));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Удалить товар",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 204', () => pm.response.to.have.status(204));",
              "pm.test('Пустое тело', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Удалённый товар",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
