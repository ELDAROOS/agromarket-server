{
  "name": "agromarket-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:init": "node db/seed.js",
    "db:local:start": "node db/local.js start",
    "db:local:stop": "node db/local.js stop",
    "test:postman": "node test/run-postman.js",
    "db:exercises": "node db/exercises.js",
    "db:migrate": "node db/migrate.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "newman": "^6.2.2",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
